# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets: set these in Supabase Edge Functions or the hosting environment.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
KAKAO_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_MOBILITY_REST_API_KEY=YOUR_KAKAO_MOBILITY_REST_API_KEY
KMA_SERVICE_KEY=YOUR_KMA_SERVICE_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=notification@YOUR_DOMAIN
